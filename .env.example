# Development only. Docker Compose overrides the DB host to postgres.
TRACE_ENV=dev
TRACE_PORT=8000
PUBLIC_PORT=8080
POSTGRES_PORT=5432
POSTGRES_PASSWORD=trace_dev_only
DATABASE_URL=postgresql://trace:trace_dev_only@127.0.0.1:5432/trace
EVIDENCE_BACKEND=filesystem
EVIDENCE_DIRECTORY=./evidence
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","[::1]"]
# Omitted AUTH_KEYS_JSON uses public dev keys. Production rejects these defaults.
# Generate independent random keys: python scripts/generate_keys.py
# AUTH_KEYS_JSON={"sha256hex":{"subject":"operator-name","role":"analyst"}}
# Production passwords must be URL-safe; percent-encode manually for external DSNs.
# TRACE_RUNTIME_PASSWORD=<random 32+ characters>
# MIGRATION_DATABASE_URL=<schema-owner DSN for provisioning only>
# Optional S3-compatible vault (not required for local filesystem mode):
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=test
MINIO_BUCKET=trace-evidence
MINIO_SECURE=false
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=trace_graph_dev_only
REDIS_URL=redis://redis:6379/0
OPENSEARCH_URL=http://opensearch:9200
TED_BASE_URL=https://api.ted.europa.eu
GLEIF_BASE_URL=https://api.gleif.org/api/v1
CELLAR_BASE_URL=https://publications.europa.eu/resource/celex
HTTP_TIMEOUT_SECONDS=30
MAX_REQUEST_BYTES=5242880
GRAPH_MAX_EXPANSIONS=5000
GRAPH_TIMEOUT_SECONDS=10
HTTP_MAX_RESPONSE_BYTES=20971520
CELLAR_MAX_RESPONSE_BYTES=67108864
OCDS_BASE_URL=https://www.find-tender.service.gov.uk/api/1.0/ocdsReleasePackages
OPENOWNERSHIP_ARCHIVE_URL=https://oo-bodsdata.s3.amazonaws.com/data/uk_version_0_4/json.zip
# Optional operator-approved HTTPS datasets; real HTTP is used when configured.
# BODS_DATASET_URL=https://publisher.example/authorized-bods.json
# PPDS_DATASET_URL=https://publisher.example/authorized-trace-procurement-export.json
# BODS_TOKEN_ENV=BODS_SOURCE_TOKEN
# PPDS_TOKEN_ENV=PPDS_SOURCE_TOKEN
# Set corresponding secret variables only when the publisher requires them.

# Official United Nations Statistics Division SDG API. The connector enforces this host.
UNSDG_BASE_URL=https://unstats.un.org/SDGAPI
# Database safety/performance bounds.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
# Institutional identity. Keep AUTH_MODE=api_key for local development.
# Production institutions should use OIDC or a tightly controlled hybrid migration window.
AUTH_MODE=api_key
# OIDC_ISSUER=https://idp.example/realms/trace
# OIDC_AUDIENCE=trace-api
# OIDC_JWKS_URL=https://idp.example/realms/trace/protocol/openid-connect/certs
# OIDC_SUBJECT_CLAIM=sub
# OIDC_ROLES_CLAIM=groups
# OIDC_ROLE_MAP_JSON={"trace-analyst":"analyst","trace-reviewer":"reviewer","trace-publisher":"publisher","trace-admin":"admin"}
# OIDC_JWKS_CACHE_SECONDS=300
# OIDC_CLOCK_SKEW_SECONDS=60
